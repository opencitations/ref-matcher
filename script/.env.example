# ============================================================================
# Reference Matching Tool — external configuration
# ============================================================================
# Copy this file to `.env` (`cp .env.example .env`) and customize the values.
# The `.env` file is already git-ignored.
#
# Value precedence (strongest to weakest):
#   1. explicit CLI flag (e.g. --threshold 30)
#   2. real environment variable (export THRESHOLD=...)
#   3. this .env file
#   4. hardcoded default in the code
#
# Loading: happens automatically when the file is named `.env` and sits in the
# directory you run the script from (or a parent), or next to
# ReferenceMatchingTool.py (the `script/` folder). You can also point to it
# explicitly with `--env-file /path/to/.env`.
# Lines left empty or commented out fall back to the default shown alongside.
# ============================================================================

# --- SPARQL endpoint --------------------------------------------------------
# OpenCitations Meta endpoint the queries are run against.
#   production: https://sparql.opencitations.net/meta        (default, public)
#   staging:    https://sparql-stg.opencitations.net/meta    (reachable only from internal network/VPN)
SPARQL_ENDPOINT=https://sparql.opencitations.net/meta

# --- Concurrency ------------------------------------------------------------
# How many references are processed in parallel (semaphore). Default: 10
MAX_CONCURRENT_REFERENCES=10
# Max number of simultaneous SPARQL HTTP requests (token bucket). Default: 10
BURST_SIZE=10
# Average request rate per second toward the endpoint. Default: 2.5
RATE_LIMIT=2.5

# --- Network / retry --------------------------------------------------------
# Timeout (seconds) for each SPARQL query. Default: 600
TIMEOUT=600
# Number of retries for failed queries. Default: 3
MAX_RETRIES=3

# --- Matching / batch -------------------------------------------------------
# Minimum score (0-48) to consider a reference "matched". Default: 26
THRESHOLD=26
# Number of files processed per batch (--batch mode). Default: 3
BATCH_SIZE=3
# Pause (seconds) between batches. Default: 10
PAUSE_DURATION=10
# Max number of consecutive server errors before stopping. Default: 10
ERROR_THRESHOLD=10

# --- Logging ----------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR. Default: INFO
LOG_LEVEL=INFO

# --- GROBID (optional) ------------------------------------------------------
# Enable the GROBID fallback for unstructured citations. Default: false
USE_GROBID=false
# Path to the GROBID configuration file (when USE_GROBID=true).
# GROBID_CONFIG_PATH=/path/to/grobid_config.json

# --- Query strategy ---------------------------------------------------------
# Use DOI-based queries. Default: true (set false to disable them)
USE_DOI=true
